[Unit]
Description=Quotelytics Freight Rating Engine (FastAPI)
After=network.target

[Service]
User=deploy
Group=deploy
WorkingDirectory=/srv/quotelytics/app
EnvironmentFile=/srv/quotelytics/app/.env
ExecStart=/srv/quotelytics/app/.venv/bin/gunicorn main:app -k uvicorn.workers.UvicornWorker -w 3 -b 127.0.0.1:8000 --timeout 120 --access-logfile - --error-logfile -
Restart=always
RestartSec=5
KillSignal=SIGTERM
PrivateTmp=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
