# ==============================================================================
# Quotelytics Inc. — Production Environment Configuration Template (.env.example)
# Hosting: Web Hosting Canada (WHC) Cloud VPS (Ubuntu 24.04 LTS / ca-central)
# ==============================================================================

# Application Environment Mode
# Set to 'production' on live server to enable:
# - Strict cookie security (Secure, HttpOnly, SameSite=Lax)
# - Disabling of public debug/showcase routes (/showcase, /flowchart, /failsafe/demo)
# - Disabling of public Swagger/OpenAPI documentation (/docs, /redoc)
APP_ENV=production

# Canonical Base URL (used in email reset & verification links)
APP_BASE_URL=https://quotelytics.ca

# Dedicated Bootstrap Administrator Credentials
# Must be set before starting the server in production to initialize the ADMIN account.
# Password must be at least 12 characters.
QUOTELYTICS_ADMIN_EMAIL=admin@quotelytics.ca
QUOTELYTICS_ADMIN_PASSWORD=ReplaceWithStrongAdminPass2026!

# Session & Cookie Security
COOKIE_SECURE=true
SESSION_SECRET=ReplaceWithCryptographicallySecureRandomSecret64Chars

# Database Configuration (Defaults to /srv/quotelytics/data/quotelytics.db)
FAILSAFE_DB_PATH=/srv/quotelytics/data/quotelytics.db

# Failsafe Guide & Quoting Governance (Master Implementation Plan v6.2)
# Tri-State Release Governance Mode: 'off', 'shadow', or 'enforce'
FAILSAFE_MODE=shadow

# Tenant Allowlist for Gradual Pilot Enforcement (Comma-separated tenant IDs)
FAILSAFE_TENANT_ALLOWLIST=pilot_tenant_123

# Double-Submit Cookie CSRF Verification on Mutating Endpoints (true / false)
ENABLE_FAILSAFE_CSRF=false

# LTL Maximum Capacity Backstop Legal Margin Buffer (in lbs, default 100.0)
LTL_MAX_WEIGHT_MARGIN_LBS=100.0

# Transactional Email (Amazon SES ca-central-1 Montreal / Postmark / SMTP)
SMTP_HOST=email-smtp.ca-central-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=ReplaceWithSmtpUser
SMTP_PASS=ReplaceWithSmtpPassword
SMTP_USE_TLS=true
SMTP_FROM=Quotelytics Security <no-reply@quotelytics.ca>

# Stripe Payment Processing (Stripe Payments Canada, Ltd.)
# Required for live billing, customer portal, and subscription webhooks (§4.4)
STRIPE_SECRET_KEY=ReplaceWithStripeLiveSecretKey
STRIPE_PUBLISHABLE_KEY=ReplaceWithStripeLivePublishableKey
STRIPE_WEBHOOK_SECRET=ReplaceWithStripeWebhookSecret

# Discord Team Integration (Antigravity Skill & Two-Way MCP Server)
# Credentials can live here (workspace-only) or in C:\Users\Dylan\.gemini\config\discord.env (global)
DISCORD_WEBHOOK_URL=ReplaceWithDiscordWebhookUrl
DISCORD_SALES_WEBHOOK_URL=ReplaceWithDiscordSalesWebhookUrl
DISCORD_SUPPORT_WEBHOOK_URL=ReplaceWithDiscordSupportWebhookUrl
DISCORD_OPS_WEBHOOK_URL=ReplaceWithDiscordOpsWebhookUrl
DISCORD_BOT_TOKEN=ReplaceWithDiscordBotToken
DISCORD_GUILD_ID=ReplaceWithDiscordServerIdOptional
